import type {Appearance} from './appearance.mjs';
export type Team = 'red' | 'blue';
export type InputFrame = { forward: number; right: number; yaw: number; jump: boolean; glide: boolean; slide: boolean };
export type PlayerState = { x: number; y: number; z: number; vx: number; vy: number; vz: number; yaw: number; team: Team; grounded: boolean; gliding: boolean; sliding: boolean; glideRemaining: number; padCooldown: number; falls: number };
export type ArenaBox = { id: string; x: number; y: number; z: number; w: number; h: number; d: number; color: number };
export type ArenaZone = { id: string; label: string; shape: string; x: number; y: number; z: number; radius: number };
export type ArenaPad = { id: string; kind: string; x: number; y: number; z: number; radius: number; lift: number; ceiling?: number };
export type RoomPlayer = PlayerState & { id: string; nickname: string; active: boolean; lastSeenMs: number; seq: number; tokenHash?: string; [key: string]: unknown };
export type ZoneState = { id: string; owner: Team | null; progress: number; counts?: Record<Team, number>; contested?: boolean };
export type RoomState = { id?: string; code?: string; version?: number; status: 'lobby' | 'running' | 'paused' | 'ended'; remainingMs: number; durationMs: number; lastTickMs: number; scores: Record<Team, number>; zones: ZoneState[]; players: RoomPlayer[]; winner: Team | 'tie' | null; endedMs?: number; locked?: boolean; [key: string]: unknown };
export type PublicPlayer = PlayerState & { appearance?: Appearance; id: string; nickname: string; active: boolean; connected: boolean; seq?: number; lastSeenMs?: number };
export type PublicRoom = { id?: string; code?: string; version?: number; epoch: number; status: RoomState['status']; serverTime: number; remainingMs: number; durationMs: number; scores: Record<Team, number>; winner: Team | 'tie' | null; locked: boolean; teacher: boolean; zones: ZoneState[]; players: PublicPlayer[]; viewerPlayerId: string | null };
export const ROOM_CAPACITY: 8;
export const STEP: number;
export const STALE_MS: number;
export const CAPTURE_MS: number;
export const PLAYER: Readonly<{ radius: number; height: number; slideHeight: number; eye: number; slideEye: number; speed: number; jump: number; gravity: number }>;
export const TEAMS: Readonly<Record<Team, { color: number; label: string; shape: string }>>;
export const ARENA: Readonly<{ name: string; boxes: ArenaBox[]; zones: ArenaZone[]; pads: ArenaPad[]; spawns: Record<Team, { x: number; y: number; z: number }>; bounds: { minX: number; maxX: number; minZ: number; maxZ: number; minY: number; maxY: number } }>;
export function createPlayer(team?: Team): PlayerState;
export function stepPlayer<T extends PlayerState>(player: T, input: InputFrame, dt?: number): T;
export function createRoomState(now: number, durationMs?: number): RoomState;
export function zonePresence(room: RoomState, zone: ArenaZone, now: number): Record<Team, number>;
export function advanceRoom<T extends RoomState>(room: T, now: number): T;
export function publicRoom(room: RoomState, viewerPlayerId?: string, teacher?: boolean): PublicRoom;
